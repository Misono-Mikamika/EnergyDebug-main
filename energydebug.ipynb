     ]
    }
   ],
   "source": [
    "workload = \"redis-server\"\n",
    "\n",
    "data_path = f\"data/{workload}/energy\"\n",
    "\n",
    "images = next(os.walk(data_path))[1]\n",
    "\n",
    "print(images)\n",
    "\n",
    "# Optionally select which images to plot\n",
    "toplot = [\"ubuntu\",\"alpinepack\", \"alpineglibc\"]"
   ]
  },
